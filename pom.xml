<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.3</version><relativePath/></parent>
 <groupId>co.smartvault</groupId><artifactId>smartvault-parent</artifactId><version>1.0.0</version><packaging>pom</packaging>
 <name>SmartVault Bank - Java 21</name>
 <modules><module>platform</module><module>identity-service</module><module>ledger-service</module><module>vaults-service</module><module>reports-service</module><module>verification</module></modules>
 <properties><argLine></argLine><junit-jupiter.version>5.14.4</junit-jupiter.version><java.version>21</java.version><maven.compiler.release>21</maven.compiler.release><jacoco.version>0.8.15</jacoco.version></properties>
 <dependencyManagement><dependencies><dependency><groupId>co.smartvault</groupId><artifactId>platform</artifactId><version>${project.version}</version></dependency></dependencies></dependencyManagement>
 <build><plugins>
 <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
 <configuration><argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine></configuration></plugin>
 <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><configuration><release>21</release></configuration></plugin>
 <plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>${jacoco.version}</version>
 <executions>
 <execution><id>agent</id><goals><goal>prepare-agent</goal></goals></execution>
 <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
 
</executions></plugin>
 </plugins></build>
</project>
